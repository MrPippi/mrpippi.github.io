---
import McButton from './McButton.astro';
import PixelGlyph from './PixelGlyph.astro';
---

<!-- 只顯示「下一個」主題的圖示：白天顯示月亮、夜晚顯示太陽 -->
<McButton size="square" data-theme-toggle>
	<PixelGlyph name="moon" size={20} class="only-light" />
	<PixelGlyph name="sun" size={20} class="only-dark" />
</McButton>

<script>
	import { langFromDocument, t } from '../i18n';
	import { THEME_EVENT, effectiveTheme, toggleTheme } from '../lib/theme';

	const media = window.matchMedia('(prefers-color-scheme: dark)');
	const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

	function syncLabel(): void {
		if (!button) return;
		const { controls } = t(langFromDocument());
		const label = effectiveTheme() === 'dark' ? controls.themeToLight : controls.themeToDark;
		button.setAttribute('aria-label', label);
		button.dataset.tooltip = label;
	}

	// 換語言（ClientRouter 換頁）或用 /time 指令切換時也要更新文字
	document.addEventListener('astro:page-load', syncLabel);
	document.addEventListener(THEME_EVENT, syncLabel);
	media.addEventListener('change', syncLabel);
	button?.addEventListener('click', toggleTheme);
</script>

<style is:global>
	/* 日夜切換：整頁淡入淡出 */
	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: 400ms;
	}
</style>
