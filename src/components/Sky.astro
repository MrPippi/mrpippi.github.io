---
// 全頁固定背景：天空漸層 + 原版太陽／月亮 + 原版雲層（以 3D 透視鋪成頭頂上的雲面，緩慢飄移）。
// 天氣（src/lib/weather.ts）：.sky[data-weather] 為 rain／thunder／snow 時天色變暗、太陽月亮躲起來，疊上原版雨雪材質；打雷會閃電。

/** 星星：[left %, top %, 大小 px, 閃爍延遲 s]，用固定公式產生，每次建置一致 */
const STARS = Array.from({ length: 48 }, (_, i) => {
	const left = (i * 37.7 + 11) % 100;
	const top = (i * 23.3 + 7) % 60;
	const size = i % 5 === 0 ? 4 : 2;
	const delay = (i % 7) * 0.6;
	return [left, top, size, delay] as const;
});
---

<div class="sky" data-sky data-weather="clear" aria-hidden="true">
	<div class="night only-dark">
		{
			STARS.map(([left, top, size, delay]) => (
				<span class="star" style={`left:${left}%;top:${top}%;width:${size}px;height:${size}px;--delay:${delay}s`} />
			))
		}
	</div>
	<img class="celestial only-light pixelated" src="/mc/sky/sun.png" alt="" width="32" height="32" />
	<img class="celestial only-dark pixelated" src="/mc/sky/moon.png" alt="" width="32" height="32" />
	<div class="cloud-layer">
		<div class="clouds"></div>
	</div>
	<div class="weather">
		<div class="tint"></div>
		<div class="precip precip--near"></div>
		<div class="precip precip--far"></div>
		<div class="flash"></div>
	</div>
</div>

<style>
	.sky {
		position: fixed;
		inset: 0;
		z-index: -1;
		overflow: hidden;
		background: linear-gradient(var(--sky-top), var(--sky-bottom));
	}

	.night {
		position: absolute;
		inset: 0;
	}

	.star {
		position: absolute;
		background: #fff;
		opacity: 0.8;
		animation: twinkle 3.2s steps(2, jump-none) var(--delay) infinite alternate;
	}

	/* 材質 32×32（本體在中間），放大 6 倍 */
	.celestial {
		position: absolute;
		top: 4%;
		right: 8%;
		width: 192px;
		height: 192px;
	}

	/* 雲面：一張很大的平面，以頂端為軸往後倒，看起來像在頭頂上延伸到地平線 */
	.cloud-layer {
		position: absolute;
		inset: 0 0 45%;
		perspective: 320px;
		perspective-origin: 50% 100%;
		-webkit-mask-image: linear-gradient(#000 40%, transparent);
		mask-image: linear-gradient(#000 40%, transparent);
	}

	.clouds {
		position: absolute;
		left: -150%;
		right: -150%;
		top: 0;
		height: 320%;
		background: url('/mc/sky/clouds.png') repeat;
		background-size: 1536px;
		image-rendering: pixelated;
		opacity: 0.85;
		transform-origin: 50% 0;
		transform: rotateX(-78deg);
		animation: cloud-drift 240s linear infinite;
	}

	:global(:root[data-theme='dark']) .clouds {
		opacity: 0.12;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .clouds {
			opacity: 0.12;
		}
	}

	/* ---------- 天氣 ---------- */
	.weather {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.weather > div {
		position: absolute;
		inset: 0;
		display: none;
	}

	.sky:not([data-weather='clear']) .weather > :is(.tint, .precip) {
		display: block;
	}

	.sky[data-weather='thunder'] .flash {
		display: block;
	}

	.sky:not([data-weather='clear']) .celestial {
		opacity: 0;
	}

	.sky:not([data-weather='clear']) .clouds {
		filter: grayscale(1) brightness(0.75);
	}

	.celestial,
	.tint {
		transition: opacity 1.5s ease;
	}

	.tint {
		background: linear-gradient(rgb(40 46 56 / 0.55), rgb(70 78 90 / 0.35));
	}

	.sky[data-weather='thunder'] .tint {
		background: linear-gradient(rgb(18 20 28 / 0.75), rgb(40 44 54 / 0.55));
	}

	/*
	 * 原版 rain.png／snow.png（64×256）往下掉；近的大而快、遠的小而慢。
	 * 圖層往上多鋪一格材質，用 transform 位移一格高度後循環：只動合成層，不必每格重畫。
	 */
	.sky .weather > .precip {
		top: calc(var(--tile) * -1);
		background-image: url('/mc/sky/rain.png');
		background-repeat: repeat;
		image-rendering: pixelated;
		will-change: transform;
		/* 不用 animation 簡寫：這條選擇器權重較高，簡寫會把下面各層設定的速度（animation-duration）蓋回 0 */
		animation-name: fall;
		animation-timing-function: linear;
		animation-iteration-count: infinite;
	}

	.precip--near {
		--tile: 512px;
		background-size: 128px var(--tile);
		opacity: 0.75;
		animation-duration: 0.55s;
	}

	.precip--far {
		--tile: 256px;
		background-size: 64px var(--tile);
		background-position: 23px 0;
		opacity: 0.45;
		animation-duration: 0.45s;
	}

	.sky[data-weather='snow'] .precip {
		background-image: url('/mc/sky/snow.png');
	}

	.sky[data-weather='snow'] .precip--near {
		animation-duration: 7s;
	}

	.sky[data-weather='snow'] .precip--far {
		animation-duration: 11s;
	}

	/* 閃電：每 11 秒左右閃兩下 */
	.flash {
		background: #dfe8ff;
		opacity: 0;
		animation: lightning 11s steps(1, end) infinite;
	}

	@keyframes fall {
		to {
			transform: translateY(var(--tile));
		}
	}

	@keyframes lightning {
		0%,
		62% {
			opacity: 0;
		}
		63% {
			opacity: 0.55;
		}
		64% {
			opacity: 0.1;
		}
		65% {
			opacity: 0.4;
		}
		67%,
		100% {
			opacity: 0;
		}
	}

	/* 減少動態效果：不顯示會動的雨雪和閃電，只留下陰天的天色 */
	@media (prefers-reduced-motion: reduce) {
		.sky .weather > :is(.precip, .flash) {
			display: none;
		}
	}

	@keyframes cloud-drift {
		to {
			background-position: 1536px 0;
		}
	}

	@keyframes twinkle {
		to {
			opacity: 0.25;
		}
	}

	@media (max-width: 560px) {
		.celestial {
			width: 128px;
			height: 128px;
			right: 2%;
		}
	}
</style>

<script>
	import { initWeather } from '../lib/weather';

	// 天空在換頁時保留（transition:persist），所以只在第一次載入時查一次天氣
	void initWeather();
</script>
