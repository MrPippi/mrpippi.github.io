---
// 旋轉全景背景（同遊戲標題畫面）：panorama_0–3 貼成立方體的四個側面，鏡頭在正中央緩慢轉動。
// 0 前、1 右、2 後、3 左（4 上、5 下）。鏡頭保持水平、視角 90 度，畫面永遠看不到上下兩面，
// 所以只貼四個側面；多貼上下面反而會在某些角度和側面互相遮擋。
const FACES = [0, 1, 2, 3];
---

<div class="panorama" aria-hidden="true">
	<div class="cube">
		{FACES.map((i) => <img class={`face face-${i}`} src={`/mc/panorama/panorama_${i}.png`} alt="" decoding="async" />)}
	</div>
</div>

<style>
	/* 立方體邊長 = 視窗較長的一邊；透視距離 = 半個邊長，剛好是 90 度視角 */
	.panorama {
		--s: max(100vw, 100vh);
		--half: calc(var(--s) / 2);
		position: absolute;
		inset: 0;
		overflow: hidden;
		perspective: var(--half);
	}

	.cube {
		position: absolute;
		left: 50%;
		top: 50%;
		width: var(--s);
		height: var(--s);
		margin: calc(var(--half) * -1) 0 0 calc(var(--half) * -1);
		transform-style: preserve-3d;
		/* 先把立方體中心移到鏡頭位置，再轉動 */
		/* 起訖角度錯開 0.37 度：Chromium 剛好轉到 90 度整數倍時會少畫半個面 */
		transform: translateZ(var(--half)) rotateY(0.37deg);
		animation: pan 180s linear infinite;
	}

	/* 每面多 2px 蓋住接縫 */
	.face {
		position: absolute;
		inset: -1px;
		width: calc(100% + 2px);
		height: calc(100% + 2px);
		backface-visibility: hidden;
		image-rendering: auto;
	}

	.face-0 {
		transform: translateZ(calc(var(--half) * -1));
	}

	.face-1 {
		transform: rotateY(-90deg) translateZ(calc(var(--half) * -1));
	}

	.face-2 {
		transform: rotateY(180deg) translateZ(calc(var(--half) * -1));
	}

	.face-3 {
		transform: rotateY(90deg) translateZ(calc(var(--half) * -1));
	}

	/* 夜晚：全景調暗偏藍 */
	:global(:root[data-theme='dark']) .panorama {
		filter: brightness(0.45) saturate(0.8) hue-rotate(10deg);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .panorama {
			filter: brightness(0.45) saturate(0.8) hue-rotate(10deg);
		}
	}

	@keyframes pan {
		to {
			transform: translateZ(var(--half)) rotateY(-359.63deg);
		}
	}
</style>
