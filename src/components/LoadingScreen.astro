---
// 換頁讀取畫面：仿原版「正在載入地形…」——變暗的泥土方塊鋪滿畫面，中間是文字與進度條。
// 每次 ClientRouter 換頁都會播：至少停 MIN_MS 讓進度條跑滿，換好頁面後再淡出。
---

<div class="loading" data-loading-screen aria-live="polite" hidden>
	<p class="text mc-text" data-loading-text></p>
	<div class="bar" aria-hidden="true"><span></span></div>
</div>

<style>
	.loading {
		position: fixed;
		inset: 0;
		z-index: 40;
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 18px;
		/* 原版選項背景：泥土材質放大 4 倍再壓暗 */
		background:
			linear-gradient(rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.72)),
			url('/mc/block/dirt.png') repeat;
		background-size: auto, 64px;
		image-rendering: pixelated;
		animation: fade-in 120ms ease-out;
		transition: opacity 250ms ease;
	}

	.loading[hidden] {
		display: none;
	}

	/* 換好頁面後淡出，淡出時不擋住點擊 */
	.loading.leaving {
		opacity: 0;
		pointer-events: none;
	}

	.text {
		margin: 0;
		font-size: 18px;
	}

	/* 進度條：灰底綠條，來回跑（換頁不知道確切進度） */
	.bar {
		position: relative;
		width: min(320px, 70vw);
		height: 6px;
		overflow: hidden;
		background: #404040;
		box-shadow: 0 0 0 2px #000;
	}

	/* 進度條：灰底綠條，從左跑到右（時間與 MIN_MS 一致） */
	.bar span {
		position: absolute;
		inset: 0;
		background: #80ff20;
		transform-origin: left;
		animation: progress var(--loading-ms, 600ms) ease-out forwards;
	}

	@keyframes progress {
		from {
			transform: scaleX(0);
		}
		to {
			transform: scaleX(1);
		}
	}

	@keyframes fade-in {
		from {
			opacity: 0;
		}
	}
</style>

<script>
	import { langFromPath, t } from '../i18n';

	/** 讀取畫面至少停多久（進度條跑滿的時間） */
	const MIN_MS = 600;
	const FADE_MS = 250;
	const screen = document.querySelector<HTMLElement>('[data-loading-screen]');
	const text = screen?.querySelector('[data-loading-text]');
	let fadeTimer: number | undefined;

	const wait = (ms: number): Promise<void> => new Promise((resolve) => window.setTimeout(resolve, ms));

	function show(pathname: string): void {
		if (!screen || !text) return;
		window.clearTimeout(fadeTimer);
		text.textContent = t(langFromPath(pathname)).loading;
		screen.style.setProperty('--loading-ms', `${MIN_MS}ms`);
		screen.classList.remove('leaving');
		// 重新播放進度條
		screen.hidden = true;
		void screen.offsetWidth;
		screen.hidden = false;
	}

	function hide(): void {
		if (!screen || screen.hidden) return;
		screen.classList.add('leaving');
		window.clearTimeout(fadeTimer);
		fadeTimer = window.setTimeout(() => {
			screen.hidden = true;
			screen.classList.remove('leaving');
		}, FADE_MS);
	}

	// 開始換頁：馬上顯示讀取畫面，載入下一頁的同時至少等 MIN_MS
	document.addEventListener('astro:before-preparation', (event) => {
		show(event.to.pathname);
		const load = event.loader;
		event.loader = async () => {
			await Promise.all([load(), wait(MIN_MS)]);
		};
	});
	document.addEventListener('astro:page-load', hide);
</script>
