---
import type { Video } from '../lib/youtube';
import FormattedDate from './FormattedDate.astro';

interface Props {
	video: Video;
}

const { video } = Astro.props;
---

<a class="video" href={video.url} target="_blank" rel="noopener noreferrer">
	<span class="thumb">
		<img src={video.thumbnail} alt="" width="320" height="180" loading="lazy" decoding="async" />
	</span>
	<span class="title">{video.title}</span>
	<span class="date"><FormattedDate date={video.published} /></span>
</a>

<style>
	.video {
		display: grid;
		gap: 0.4rem;
		color: var(--text);
		text-decoration: none;
	}

	.thumb {
		display: block;
		aspect-ratio: 16 / 9;
		border: 2px solid #000;
		background: #111;
		overflow: hidden;
	}

	.thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 160ms ease;
	}

	.video:hover .thumb,
	.video:focus-visible .thumb {
		border-color: #fff;
	}

	.video:hover img {
		transform: scale(1.04);
	}

	.title {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-weight: 700;
		line-height: 1.5;
	}

	.video:hover .title {
		color: var(--yellow);
	}

	.date {
		color: var(--text-muted);
		font-size: 0.8rem;
	}
</style>
