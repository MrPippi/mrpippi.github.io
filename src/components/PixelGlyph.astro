---
import { PIXEL_GLYPHS, toRects, type GlyphName } from '../lib/pixel-glyphs';

interface Props {
	name: GlyphName;
	size?: number;
	class?: string;
}

const { name, size = 16, class: className } = Astro.props;
const rows = PIXEL_GLYPHS[name];
const rects = toRects(rows);
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox={`0 0 ${rows[0].length} ${rows.length}`}
	shape-rendering="crispEdges"
	fill="currentColor"
	aria-hidden="true"
	focusable="false"
>
	{rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" />)}
</svg>
