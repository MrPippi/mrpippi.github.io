---
// 原版選項畫面的滑桿：石材底座 + 拉桿，文字（例如「音樂：35%」）顯示在滑桿正中央。
// 文字由使用它的腳本依數值更新（data-slider-label）。
interface Props {
	id: string;
	value: number;
	label: string;
}

const { id, value, label } = Astro.props;
---

<label class="mc-slider" for={id}>
	<input id={id} type="range" min="0" max="100" step="1" value={value} aria-label={label} />
	<span class="mc-slider-label mc-text" data-slider-label aria-hidden="true">{label}</span>
</label>

<style>
	.mc-slider {
		position: relative;
		display: block;
		width: 100%;
		height: 40px;
	}

	/* 底座：原版 slider（200×20，九宮格邊框 1）放大 2 倍 */
	input {
		width: 100%;
		height: 40px;
		margin: 0;
		border: 2px solid transparent;
		border-image: url('/mc/gui/slider.png') 1 fill / 2px / 0 stretch;
		background: none;
		image-rendering: pixelated;
		appearance: none;
		-webkit-appearance: none;
		cursor: pointer;
	}

	input:hover,
	input:focus-visible {
		outline: none;
		border-image-source: url('/mc/gui/slider_highlighted.png');
	}

	/* 拉桿：原版 slider_handle（8×20）放大 2 倍 */
	input::-webkit-slider-thumb {
		width: 16px;
		height: 40px;
		border: 0;
		border-radius: 0;
		background: url('/mc/gui/slider_handle.png') center / 100% 100%;
		image-rendering: pixelated;
		appearance: none;
		-webkit-appearance: none;
	}

	input::-moz-range-thumb {
		width: 16px;
		height: 40px;
		border: 0;
		border-radius: 0;
		background: url('/mc/gui/slider_handle.png') center / 100% 100%;
		image-rendering: pixelated;
	}

	input:hover::-webkit-slider-thumb,
	input:focus-visible::-webkit-slider-thumb {
		background-image: url('/mc/gui/slider_handle_highlighted.png');
	}

	input:hover::-moz-range-thumb,
	input:focus-visible::-moz-range-thumb {
		background-image: url('/mc/gui/slider_handle_highlighted.png');
	}

	.mc-slider-label {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		color: var(--text);
		font-size: 18px;
		line-height: 1;
		pointer-events: none;
	}

	.mc-slider:hover .mc-slider-label,
	input:focus-visible + .mc-slider-label {
		color: #ffffa0;
	}
</style>
