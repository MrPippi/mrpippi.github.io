---
import { langFromPath, t } from '../i18n';

const dict = t(langFromPath(Astro.url.pathname));
const splashes = dict.splashes;
---

<h1 class="logo">
	<span class="visually-hidden">{dict.profile.name} </span>
	<span class="wordmark-box" aria-hidden="true">
		<img class="wordmark" src="/icon.png" alt="" width="602" height="144" fetchpriority="high" />
		<!-- 黃色標語釘在 Logo 右下角，和遊戲一樣斜放並脈動 -->
		<span class="splash mc-text" data-splash data-splashes={JSON.stringify(splashes)}>{splashes[0]}</span>
	</span>
</h1>

<style>
	.logo {
		margin: 0;
		font-weight: 400;
		line-height: 1;
		text-align: center;
	}

	.wordmark-box {
		position: relative;
		display: inline-block;
	}

	/* 像素風 Logo 圖（public/icon.png），隨螢幕寬度縮小 */
	.wordmark {
		display: block;
		width: min(602px, calc(100vw - 32px));
		height: auto;
		image-rendering: pixelated;
	}

	.splash {
		position: absolute;
		top: 78%;
		left: 92%;
		color: var(--yellow);
		font-size: 18px;
		line-height: 1;
		text-shadow: var(--mc-px) var(--mc-px) 0 #3f3f15;
		white-space: nowrap;
		transform: translate(-50%, -50%) rotate(-20deg);
		animation: splash-pulse 0.45s ease-in-out infinite alternate;
		cursor: pointer;
		user-select: none;
	}

	@keyframes splash-pulse {
		to {
			transform: translate(-50%, -50%) rotate(-20deg) scale(1.1);
		}
	}

	/* 窄螢幕：標語縮小並往左移，長句也不會超出畫面 */
	@media (max-width: 480px) {
		.splash {
			left: 68%;
			top: 100%;
			font-size: 15px;
		}
	}
</style>

<script>
	import { recordSplashClick } from '../lib/advancements';
	import { playClick } from '../lib/sound';

	/** 抽一句和目前不同的標語 */
	function pickSplash(splash: HTMLElement): void {
		try {
			const parsed: unknown = JSON.parse(splash.dataset.splashes ?? '[]');
			const options = Array.isArray(parsed) ? parsed.filter((v): v is string => typeof v === 'string') : [];
			const others = options.length > 1 ? options.filter((v) => v !== splash.textContent) : options;
			const pick = others[Math.floor(Math.random() * others.length)];
			if (pick !== undefined) splash.textContent = pick;
		} catch {
			// 解析失敗就保留預設標語
		}
	}

	// 每次進到標題畫面（含 ClientRouter 換頁）都重新抽一句標語
	document.addEventListener('astro:page-load', () => {
		const splash = document.querySelector<HTMLElement>('[data-splash]');
		if (splash) pickSplash(splash);
	});

	// 點標語換一句（彩蛋，累計次數解鎖進度）
	document.addEventListener('click', (event) => {
		const splash = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-splash]') : null;
		if (!splash) return;
		playClick();
		pickSplash(splash);
		recordSplashClick();
	});
</script>
