---
import { DATE_LOCALE, TIME_ZONE, langFromPath } from '../i18n';

interface Props {
	date: Date;
}

const { date } = Astro.props;
const locale = DATE_LOCALE[langFromPath(Astro.url.pathname)];
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric', timeZone: TIME_ZONE })}
</time>
