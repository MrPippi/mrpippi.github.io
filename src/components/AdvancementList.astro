---
// 進度清單：伺服器端先全部畫成「未達成」，瀏覽器載入後依 localStorage 標示已達成的項目。
// 隱藏進度達成前只顯示「???」，圖示換成問號。
import { langFromPath, t } from '../i18n';
import { type Advancement, ADVANCEMENTS } from '../lib/advancements';

const lang = langFromPath(Astro.url.pathname);
const dict = t(lang).advancements;
/** 清單上顯示的標題與說明：隱藏進度先用「???」 */
const shown = (a: Advancement) => (a.hidden ? dict.hidden : dict.items[a.id]);
---

<section aria-labelledby="advancements-title">
	<h2 id="advancements-title" class="mc-text">
		{dict.heading} <span class="count" data-adv-count>0 / {ADVANCEMENTS.length}</span>
	</h2>
	<ul class="grid">
		{
			ADVANCEMENTS.map((a) => (
				<li
					class="item"
					data-adv={a.id}
					data-adv-hidden={a.hidden ? '' : undefined}
					tabindex="0"
					data-tooltip={shown(a).title}
					data-tooltip-lines={`${shown(a).description}\n-${t(lang).tooltip.locked}`}
				>
					<span class="frame">
						{a.hidden && (
							<span class="mystery mc-text" aria-hidden="true">
								?
							</span>
						)}
						<img
							src={a.hidden ? undefined : a.icon}
							data-icon={a.icon}
							alt=""
							width="32"
							height="32"
							class="pixelated"
						/>
					</span>
					<span class="text">
						<span class="title mc-text" data-adv-title>
							{shown(a).title}
						</span>
						<span class="desc" data-adv-desc>
							{shown(a).description}
						</span>
					</span>
				</li>
			))
		}
	</ul>
</section>

<style>
	h2 {
		margin: 2.5rem 0 0.75rem;
		font-size: 18px;
	}

	.count {
		margin-left: 0.5rem;
		color: var(--yellow);
		text-shadow: var(--mc-px) var(--mc-px) 0 #3f3f15;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(210px, 100%), 1fr));
		gap: 8px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 0.7rem;
		border: 2px solid rgb(255 255 255 / 0.12);
		background: rgb(0 0 0 / 0.35);
	}

	/* 原版進度框：未達成是灰框、達成是金框 */
	.frame {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		border: 3px solid #555;
		background: #2a2a2a;
	}

	.frame img {
		width: 32px;
		height: 32px;
		filter: brightness(0) opacity(0.5);
	}

	.text {
		display: grid;
		min-width: 0;
		line-height: 1.4;
	}

	.title {
		color: var(--text-muted);
		font-size: 15px;
	}

	.desc {
		color: var(--text-muted);
		font-size: 0.78rem;
	}

	/* 隱藏進度達成前：問號代替圖示 */
	.mystery {
		color: #777;
		font-size: 24px;
	}

	.item[data-adv-hidden]:not(.done) img,
	.item.done .mystery {
		display: none;
	}

	.item.done {
		border-color: rgb(255 214 90 / 0.45);
	}

	.item.done .frame {
		border-color: #e5b13a;
		background: #3d3215;
	}

	.item.done .frame img {
		filter: none;
	}

	.item.done .title {
		color: var(--yellow);
	}

	.item.done .desc {
		color: var(--text-dim);
	}
</style>

<script>
	import { type AdvancementId, langFromDocument, t } from '../i18n';
	import { ADVANCEMENT_EVENT, ADVANCEMENTS, unlockedIds } from '../lib/advancements';

	function render(): void {
		const unlocked = unlockedIds();
		const dict = t(langFromDocument());
		document.querySelectorAll<HTMLElement>('[data-adv]').forEach((el) => {
			const id = el.dataset.adv as AdvancementId;
			const done = unlocked.includes(id);
			el.classList.toggle('done', done);
			const secret = el.hasAttribute('data-adv-hidden') && !done;
			const { title, description } = secret ? dict.advancements.hidden : dict.advancements.items[id];
			// 隱藏進度達成後才載入圖示
			const img = el.querySelector<HTMLImageElement>('img[data-icon]');
			if (img && !secret && !img.getAttribute('src')) img.src = img.dataset.icon ?? '';
			const titleEl = el.querySelector('[data-adv-title]');
			const descEl = el.querySelector('[data-adv-desc]');
			if (titleEl) titleEl.textContent = title;
			if (descEl) descEl.textContent = description;
			// 提示框：達成的進度名稱顯示黃色，最後一行是達成狀態（+ 綠色、- 灰色）
			const status = done ? `+${dict.tooltip.unlocked}` : `-${dict.tooltip.locked}`;
			el.dataset.tooltip = title;
			el.dataset.tooltipLines = `${description}\n${status}`;
			if (done) el.dataset.tooltipColor = 'yellow';
			else delete el.dataset.tooltipColor;
		});
		const count = document.querySelector('[data-adv-count]');
		if (count) count.textContent = `${unlocked.length} / ${ADVANCEMENTS.length}`;
	}

	document.addEventListener('astro:page-load', render);
	document.addEventListener(ADVANCEMENT_EVENT, render);
</script>
