---
// 聊天列（彩蛋）：和遊戲一樣按 T 開啟聊天、按 / 直接打指令，Enter 送出、Esc 關閉、Tab 自動完成、↑↓ 叫出輸入紀錄。
// 觸控裝置沒有實體鍵盤，改用右下角的聊天按鈕（ChatToggle.astro）開啟。指令解析在 src/lib/commands.ts，執行在 src/lib/command-runner.ts。
---

<div class="chat" data-chat>
	<ol class="log mc-text" data-chat-log aria-live="polite"></ol>
	<ul class="suggest mc-text" data-chat-suggest hidden></ul>
	<form class="bar" data-chat-form hidden>
		<input
			class="input mc-text"
			data-chat-input
			type="text"
			maxlength="256"
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
			enterkeyhint="send"
		/>
	</form>
</div>

<style>
	/* 聊天訊息前的玩家頭像，和文字一樣高 */
	.log :global(.head) {
		width: 1em;
		height: 1em;
		margin-right: 0.35em;
		vertical-align: -0.12em;
		image-rendering: pixelated;
	}

	.chat {
		position: fixed;
		left: 12px;
		/* 放在右下角按鈕列與頁尾文字的上方，不互相遮住 */
		bottom: calc(var(--controls-space) + 8px);
		z-index: 20;
		display: grid;
		gap: 4px;
		width: min(600px, calc(100vw - 24px));
		pointer-events: none;
	}

	.log {
		display: grid;
		max-height: 50vh;
		margin: 0;
		padding: 0;
		overflow: hidden;
		list-style: none;
		font-size: 18px;
		line-height: 1.3;
	}

	/* 原版聊天：每行半透明黑底，關閉輸入列後 10 秒淡出 */
	.log :global(li) {
		padding: 1px 6px;
		background: rgb(0 0 0 / 0.5);
		overflow-wrap: anywhere;
		animation: fade-out 0.6s ease 9.4s forwards;
	}

	.log :global(li[data-tone='info']) {
		color: #c6c6c6;
	}

	.log :global(li[data-tone='error']) {
		color: #ff5555;
		text-shadow: var(--mc-px) var(--mc-px) 0 #3f1515;
	}

	/* 輸入列開著時顯示全部紀錄，可以捲動 */
	.chat[data-open] {
		pointer-events: auto;
	}

	.chat[data-open] .log {
		overflow-y: auto;
	}

	.chat[data-open] .log :global(li) {
		animation: none;
		opacity: 1;
	}

	/* 候選太多時（例如所有物品）可以捲動 */
	.suggest {
		justify-self: start;
		max-height: min(40vh, 18em);
		overflow-y: auto;
		margin: 0;
		padding: 2px 0;
		list-style: none;
		background: rgb(0 0 0 / 0.8);
		font-size: 18px;
		line-height: 1.3;
	}

	.suggest[hidden],
	.bar[hidden] {
		display: none;
	}

	.suggest :global(button) {
		display: block;
		width: 100%;
		padding: 0 8px;
		border: 0;
		background: none;
		color: #a8a8a8;
		font: inherit;
		text-align: left;
		text-shadow: inherit;
		cursor: pointer;
	}

	.suggest :global(li:first-child button),
	.suggest :global(button:hover) {
		color: var(--yellow);
	}

	.input {
		width: 100%;
		height: 30px;
		padding: 0 6px;
		border: 0;
		background: rgb(0 0 0 / 0.55);
		color: var(--text);
		font-size: 18px;
		caret-color: var(--text);
	}

	.input:focus-visible {
		outline: none;
	}

	@keyframes fade-out {
		to {
			opacity: 0;
		}
	}
</style>

<script>
	import { langFromDocument, t } from '../i18n';
	import { runAction, type Tone } from '../lib/command-runner';
	import { CHAT_OPEN_EVENT, CHAT_PRINT_EVENT, type ChatPrint } from '../lib/chat';
	import { parseCommand, suggest } from '../lib/commands';

	const MAX_LINES = 50;
	const MAX_HISTORY = 50;

	const root = document.querySelector<HTMLElement>('[data-chat]');
	const log = root?.querySelector<HTMLOListElement>('[data-chat-log]');
	const form = root?.querySelector<HTMLFormElement>('[data-chat-form]');
	const input = root?.querySelector<HTMLInputElement>('[data-chat-input]');
	const suggestBox = root?.querySelector<HTMLUListElement>('[data-chat-suggest]');

	let history: readonly string[] = [];
	let historyIndex = -1;

	function print(text: string, tone: Tone = 'chat', head?: string): void {
		if (!log) return;
		const line = document.createElement('li');
		line.textContent = text;
		// 改過名字的玩家：訊息前面放皮膚的 2D 頭像（載入失敗就拿掉）
		if (head) {
			const img = document.createElement('img');
			img.className = 'head pixelated';
			img.src = head;
			img.alt = '';
			img.width = 16;
			img.height = 16;
			img.addEventListener('error', () => img.remove(), { once: true });
			line.prepend(img);
		}
		line.dataset.tone = tone;
		log.append(line);
		while (log.children.length > MAX_LINES) log.firstElementChild?.remove();
		log.scrollTop = log.scrollHeight;
	}

	document.addEventListener(CHAT_PRINT_EVENT, (event) => {
		const { text, tone } = (event as CustomEvent<ChatPrint>).detail;
		print(text, tone);
	});

	function renderSuggestions(): void {
		if (!suggestBox || !input) return;
		const options = suggest(input.value);
		suggestBox.replaceChildren(
			...options.map((option) => {
				const item = document.createElement('li');
				const button = document.createElement('button');
				button.type = 'button';
				button.textContent = option;
				button.addEventListener('mousedown', (event) => event.preventDefault()); // 不讓輸入框失焦
				button.addEventListener('click', () => complete(option));
				item.append(button);
				return item;
			}),
		);
		suggestBox.hidden = options.length === 0;
	}

	function complete(option: string): void {
		if (!input) return;
		input.value = `${option} `;
		input.focus();
		renderSuggestions();
	}

	function isOpen(): boolean {
		return root?.hasAttribute('data-open') ?? false;
	}

	function open(prefill: string): void {
		if (!root || !form || !input) return;
		input.setAttribute('aria-label', t(langFromDocument()).commands.inputLabel);
		root.setAttribute('data-open', '');
		form.hidden = false;
		input.value = prefill;
		historyIndex = -1;
		input.focus();
		renderSuggestions();
	}

	function close(): void {
		if (!root || !form || !input) return;
		root.removeAttribute('data-open');
		form.hidden = true;
		input.value = '';
		if (suggestBox) suggestBox.hidden = true;
		input.blur();
	}

	/**
	 * 只有沒按 Ctrl／Alt／⌘、而且焦點不在任何元素上（沒在輸入框打字、也沒停在按鈕或連結上）時才開啟聊天列，
	 * 減少語音輸入或鍵盤操作時誤觸單鍵快捷鍵。
	 */
	function isTypingElsewhere(event: KeyboardEvent): boolean {
		if (event.ctrlKey || event.metaKey || event.altKey || event.isComposing) return true;
		const active = document.activeElement;
		return active !== null && active !== document.body && active !== document.documentElement;
	}

	document.addEventListener(CHAT_OPEN_EVENT, (event) => {
		if (!isOpen()) open((event as CustomEvent<string>).detail);
	});

	function recall(step: number): void {
		if (!input || history.length === 0) return;
		historyIndex = Math.min(history.length - 1, Math.max(-1, historyIndex + step));
		input.value = historyIndex === -1 ? '' : history[history.length - 1 - historyIndex];
		renderSuggestions();
	}

	document.addEventListener('keydown', (event) => {
		if (isOpen() || isTypingElsewhere(event)) return;
		if (event.key === 't' || event.key === 'T' || event.key === '/') {
			event.preventDefault();
			open(event.key === '/' ? '/' : '');
		}
	});

	input?.addEventListener('keydown', (event) => {
		if (event.isComposing) return;
		if (event.key === 'Escape') {
			event.preventDefault();
			close();
		} else if (event.key === 'Tab') {
			const [first] = suggest(input.value);
			if (first) {
				event.preventDefault();
				complete(first);
			}
		} else if (event.key === 'ArrowUp' || event.key === 'ArrowDown') {
			event.preventDefault();
			recall(event.key === 'ArrowUp' ? 1 : -1);
		}
	});

	input?.addEventListener('input', renderSuggestions);

	// 點到聊天列以外的地方就關閉；點聊天紀錄（例如拖捲軸）時保持開啟、焦點回到輸入框
	let pointerInChat = false;
	root?.addEventListener('pointerdown', () => {
		pointerInChat = true;
	});
	document.addEventListener('pointerup', () => window.setTimeout(() => (pointerInChat = false)));
	form?.addEventListener('focusout', (event) => {
		if (event.relatedTarget instanceof Node && root?.contains(event.relatedTarget)) return;
		if (pointerInChat) {
			window.setTimeout(() => input?.focus());
			return;
		}
		close();
	});

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!input) return;
		const text = input.value;
		const action = parseCommand(text);
		if (action.kind !== 'empty') history = [...history, text.trim()].slice(-MAX_HISTORY);
		close();
		if (action.kind === 'clear') {
			log?.replaceChildren();
			return;
		}
		void runAction(action, print).catch((error: unknown) => {
			console.error('[chat] 指令執行失敗：', error);
			print(t(langFromDocument()).commands.failed, 'error');
		});
	});
</script>
