---
import PostList from '../../components/PostList.astro';
import PostSearch from '../../components/PostSearch.astro';
import TagChip from '../../components/TagChip.astro';
import { t } from '../../i18n';
import MenuLayout from '../../layouts/MenuLayout.astro';
import { collectTags, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = collectTags(posts);
const dict = t('zh-TW').blog;
---

<MenuLayout heading={dict.heading} description={dict.description}>
	{
		posts.length === 0 ? (
			<p class="empty">{dict.empty}</p>
		) : (
			<>
				<PostSearch />
				{tags.length > 0 && (
					<nav class="tags" aria-label={dict.tagsLabel} data-search-hide>
						{tags.map(({ tag, count }) => (
							<TagChip tag={tag} count={count} />
						))}
					</nav>
				)}
				<div data-search-hide>
					<PostList posts={posts} />
				</div>
			</>
		)
	}
</MenuLayout>

<style>
	.empty {
		margin: 0;
		color: var(--text-muted);
		text-align: center;
	}

	.tags[hidden] {
		display: none;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 1.25rem;
	}
</style>
