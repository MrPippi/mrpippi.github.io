---
import Banner from '../../components/Banner.astro';
import TitleLogo from '../../components/TitleLogo.astro';
import { PROFILE } from '../../consts';
import { TIME_ZONE, langFromPath, langStaticPaths, localizePath, t } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../../lib/posts';

export function getStaticPaths() {
	return langStaticPaths();
}

const lang = langFromPath(Astro.url.pathname);
const dict = t(lang);
const hasPosts = (await getPublishedPosts()).length > 0;
const now = new Date();
// 版本號 = 建置日期（台灣時間），例如 2026.10.10
const version = new Intl.DateTimeFormat('en-CA', { timeZone: TIME_ZONE, year: 'numeric', month: 'numeric', day: 'numeric' })
	.format(now)
	.replaceAll('-', '.');
---

<BaseLayout>
	<div class="title-screen">
		<main class="stage">
			<TitleLogo />
			<nav class="menu" aria-label={dict.menu.label}>
				<Banner href={localizePath('/about/', lang)} tone="green" icon="/mc/item/name_tag.png" sub={dict.menu.about.sub}>
					{dict.menu.about.title}
				</Banner>
				<Banner href={localizePath('/portfolio/', lang)} tone="red" icon="/mc/item/bundle.png" sub={dict.menu.portfolio.sub}>
					{dict.menu.portfolio.title}
				</Banner>
				<Banner href={localizePath('/media/', lang)} tone="teal" icon="/mc/item/music_disc_cat.png" sub={dict.menu.media.sub}>
					{dict.menu.media.title}
				</Banner>
				<Banner
					href="/blog/"
					tone="purple"
					icon="/mc/item/writable_book.png"
					sub={dict.menu.blog.sub}
					disabled={!hasPosts}
					tag={hasPosts ? undefined : dict.menu.blog.wip}
				>
					{dict.menu.blog.title}
				</Banner>
				<Banner
					href={localizePath('/contact/', lang)}
					tone="yellow"
					icon="/mc/item/goat_horn.png"
					sub={dict.menu.contact.sub}
					class="wide"
				>
					{dict.menu.contact.title}
				</Banner>
			</nav>
		</main>

		<footer class="corner mc-text">
			<span>{PROFILE.handle} Edition v{version}</span>
			<span>{dict.menu.unofficial} · © {now.getFullYear()} {dict.profile.name}</span>
		</footer>
	</div>
</BaseLayout>

<style>
	/* 上：Logo 與選單（置中）；下：版本號與版權。頁尾跟著內容往下排，選單再長也不會被它蓋住 */
	.title-screen {
		display: grid;
		grid-template-rows: 1fr auto;
		min-height: 100vh;
		min-height: 100dvh;
		padding: 0 var(--gutter);
	}

	.stage {
		align-self: center;
		display: grid;
		justify-items: center;
		gap: clamp(2.5rem, 7vh, 4.5rem);
		width: 100%;
		max-width: 760px;
		margin: 0 auto;
		padding: 5rem 0 2.5rem;
	}

	.menu {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px 16px;
		width: min(720px, 100%);
	}

	/* 5 顆按鈕：最後一顆（聯絡）佔滿一整列 */
	.menu > :global(.wide) {
		grid-column: 1 / -1;
	}

	@media (max-width: 640px) {
		.menu {
			grid-template-columns: 1fr;
		}
	}

	/* 版本號與版權：在選單下方，並留出右下角按鈕列的高度 */
	.corner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 1rem;
		margin: 0 calc(var(--gutter) * -1);
		padding: 0.6rem 0.75rem var(--controls-space);
		color: var(--text);
		font-size: 18px;
		line-height: 1.4;
	}
</style>
